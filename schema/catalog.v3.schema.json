{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeelakedevv.github.io/cld-hub/schema/catalog.v3.schema.json",
  "title": "CLD Hub katalog v3",
  "description": "Lumina Software mağaza kataloğu. Metinler düz yazı ya da dile göre eşleme olabilir.",
  "type": "object",
  "required": ["catalog_version", "languages", "apps"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": { "const": 3 },
    "last_updated": { "type": "string" },
    "languages": {
      "description": "Katalog içeriğinin dilleri; ilki varsayılan (eksik çevirilerde kullanılır).",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/lang" }
    },
    "catalog_url": { "$ref": "#/$defs/httpUrl" },
    "stats_url": { "$ref": "#/$defs/httpUrl" },
    "media_base": {
      "description": "Göreli görsel yollarının (media/…) çözüldüğü adres; / ile biter.",
      "type": "string", "pattern": "^https://.+/$"
    },
    "apps": { "type": "array", "items": { "$ref": "#/$defs/app" } },
    "collections": {
      "description": "Elle seçilmiş raflar; sıra mağazadaki görünüş sırasıdır.",
      "type": "array", "items": { "$ref": "#/$defs/collection" }
    }
  },
  "$defs": {
    "collection": {
      "type": "object", "required": ["id", "title", "apps"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "apps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "text": {
      "description": "Düz yazı (tüm diller) ya da { dil: yazı } eşlemesi.",
      "oneOf": [
        { "$ref": "#/$defs/nonEmpty" },
        {
          "type": "object", "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/lang" },
          "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
        }
      ]
    },
    "httpUrl": { "type": "string", "pattern": "^https?://\\S+$" },
    "mediaPath": {
      "description": "Tam adres ya da media_base'e göre göreli yol (media/<id>/…).",
      "type": "string", "pattern": "^(https?://\\S+|media/[A-Za-z0-9_-]+/[A-Za-z0-9_./-]+)$"
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$" },
    "screenshot": {
      "oneOf": [
        { "$ref": "#/$defs/mediaPath" },
        {
          "type": "object", "required": ["url"], "additionalProperties": false,
          "properties": { "url": { "$ref": "#/$defs/mediaPath" }, "caption": { "$ref": "#/$defs/text" } }
        }
      ]
    },
    "platformFile": {
      "description": "Platform kaydı. url yoksa platform yalnızca planlanmıştır.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/httpUrl" },
        "size_mb": { "type": "number", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "kind": { "enum": ["file", "zip", "inno", "apk"] },
        "version": { "$ref": "#/$defs/version" },
        "min_os": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "date": { "$ref": "#/$defs/date" },
        "notes": { "$ref": "#/$defs/text" },
        "platforms": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "windows": { "$ref": "#/$defs/platformFile" },
            "linux": { "$ref": "#/$defs/platformFile" },
            "macos": { "$ref": "#/$defs/platformFile" },
            "android": {
              "allOf": [
                { "$ref": "#/$defs/platformFile" },
                { "properties": { "kind": { "const": "apk" } } }
              ]
            }
          }
        }
      }
    },
    "genre": {
      "enum": [
        "productivity", "utilities", "security", "media", "graphics", "music", "education",
        "communication", "developer_tools", "finance", "health",
        "action", "adventure", "arcade", "casual", "puzzle", "racing", "rpg", "simulation",
        "sports", "strategy"
      ]
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "category", "status", "release"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
        "name": { "$ref": "#/$defs/text" },
        "category": { "enum": ["app", "game"] },
        "status": { "enum": ["upcoming", "released", "archived"] },
        "subtitle": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "developer": { "$ref": "#/$defs/nonEmpty" },
        "genres": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/genre" } },
        "age_rating": { "enum": [3, 7, 12, 16, 18] },
        "app_languages": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lang" } },
        "links": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "website": { "$ref": "#/$defs/httpUrl" },
            "privacy": { "$ref": "#/$defs/httpUrl" },
            "support": { "type": "string", "pattern": "^(https?://|mailto:)\\S+$" }
          }
        },
        "github_repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "icon": { "type": "string" },
        "featured": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "media": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "logo": { "$ref": "#/$defs/mediaPath" },
            "cover": { "$ref": "#/$defs/mediaPath" },
            "video": { "$ref": "#/$defs/httpUrl" },
            "screenshots": {
              "type": "object",
              "propertyNames": { "anyOf": [{ "const": "default" }, { "$ref": "#/$defs/lang" }] },
              "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/screenshot" } }
            }
          }
        },
        "release": { "$ref": "#/$defs/release" },
        "history": {
          "type": "array",
          "items": {
            "type": "object", "required": ["version"], "additionalProperties": false,
            "properties": {
              "version": { "$ref": "#/$defs/version" },
              "date": { "$ref": "#/$defs/date" },
              "notes": { "$ref": "#/$defs/text" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["released", "archived"] } } },
          "then": {
            "properties": {
              "release": {
                "required": ["version", "platforms"],
                "properties": {
                  "platforms": {
                    "minProperties": 1,
                    "additionalProperties": true,
                    "anyOf": [
                      { "properties": { "windows": { "required": ["url"] } }, "required": ["windows"] },
                      { "properties": { "linux": { "required": ["url"] } }, "required": ["linux"] },
                      { "properties": { "macos": { "required": ["url"] } }, "required": ["macos"] },
                      { "properties": { "android": { "required": ["url"] } }, "required": ["android"] }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
